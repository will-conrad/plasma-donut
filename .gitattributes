# Datasheets and fab files are binary: no text diffs or line-ending changes.
*.pdf   binary
*.xlsx  binary
*.png   binary
*.step  binary
# The datasheet .md files are generated by hardware/datasheets/build_md.py.
# Mark them so GitHub folds them in diffs and leaves them out of language stats.
hardware/datasheets/*.md linguist-generated=true
hardware/datasheets/INDEX.md linguist-generated=false
# Gerbers and KiCad files are text, but keep their exact line endings.
*.gbr        -text
*.drl        -text
*.kicad_*    -text
